# Required for direct live execution. Never commit real values in .env.
API_KEY=
API_SECRET=
LIVE_TRADING_ENABLED=false

# All application settings live in bot/config.py; these are optional overrides.
# Paste the Neon connection string. Standard `postgresql://` URLs are accepted;
# the app uses psycopg internally and preserves Neon's `sslmode=require` query.
DB_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
LOG_FILE=/app/logs/quant-bot.log
EXCHANGE_BASE_URL=https://mock-api.roostoo.com
SYMBOLS=BTC/USD,ETH/USD,SOL/USD,BNB/USD
POLL_INTERVAL_SECONDS=60
MAX_OPEN_POSITIONS=4
